{
  "name": "diff-mark",
  "displayName": "Diff Mark",
  "description": "Git diff highlight lines against any branch. Gutter indicators for changed, added and deleted lines. Explorer badges, side panel with all diff files, and inline diff view.",
  "version": "0.2.1",
  "publisher": "VolodymyrK",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "homepage": "https://github.com/vovabcps/vscode-diff-mark",
  "repository": {
    "type": "git",
    "url": "https://github.com/vovabcps/vscode-diff-mark.git"
  },
  "bugs": {
    "url": "https://github.com/vovabcps/vscode-diff-mark/issues"
  },
  "keywords": [
    "git",
    "diff",
    "branch",
    "highlight",
    "compare",
    "git diff",
    "branch diff",
    "compare branches",
    "diff highlight",
    "highlight lines",
    "git compare",
    "line diff",
    "gutter",
    "gutter highlight",
    "git changes",
    "changed lines",
    "diff viewer",
    "branch comparison",
    "git decorations",
    "scm"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diffMarkContainer",
          "title": "Diff Mark",
          "icon": "$(git-compare)"
        }
      ]
    },
    "views": {
      "diffMarkContainer": [
        {
          "id": "diffMarkPanel",
          "name": "Changed Files",
          "icon": "$(git-compare)",
          "contextualTitle": "Diff Mark"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "diffMarkPanel",
        "contents": "No branch selected.\n[Select Branch to Compare](command:diffMark.selectBranch)"
      }
    ],
    "commands": [
      {
        "command": "diffMark.selectBranch",
        "title": "Diff Mark: Select Branch to Compare",
        "icon": "$(git-branch)"
      },
      {
        "command": "diffMark.stop",
        "title": "Diff Mark: Stop Highlighting",
        "icon": "$(circle-slash)"
      },
      {
        "command": "diffMark.showDiff",
        "title": "Diff Mark: Show Diff for Current File"
      },
      {
        "command": "diffMark.refresh",
        "title": "Diff Mark: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "diffMark.openFileDiff",
        "title": "Show Diff"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "diffMark.selectBranch",
          "when": "view == diffMarkPanel",
          "group": "navigation@1"
        },
        {
          "command": "diffMark.refresh",
          "when": "view == diffMarkPanel",
          "group": "navigation@2"
        },
        {
          "command": "diffMark.stop",
          "when": "view == diffMarkPanel",
          "group": "navigation@3"
        }
      ]
    },
    "colors": [
      {
        "id": "diffMark.modifiedForeground",
        "description": "Color for files modified vs the compared branch",
        "defaults": {
          "dark": "#4FC1FF",
          "light": "#0070C1",
          "highContrast": "#4FC1FF"
        }
      },
      {
        "id": "diffMark.addedForeground",
        "description": "Color for files added vs the compared branch",
        "defaults": {
          "dark": "#C586C0",
          "light": "#8B008B",
          "highContrast": "#C586C0"
        }
      },
      {
        "id": "diffMark.deletedForeground",
        "description": "Color for files deleted vs the compared branch",
        "defaults": {
          "dark": "#F48771",
          "light": "#B83232",
          "highContrast": "#F48771"
        }
      },
      {
        "id": "diffMark.renamedForeground",
        "description": "Color for files renamed vs the compared branch",
        "defaults": {
          "dark": "#73C991",
          "light": "#1E7E34",
          "highContrast": "#73C991"
        }
      }
    ],
    "configuration": {
      "title": "Diff Mark",
      "properties": {
        "diffMark.addedColor": {
          "type": "string",
          "default": "rgba(40, 160, 40, 0.6)",
          "description": "Color for added lines gutter indicator"
        },
        "diffMark.modifiedColor": {
          "type": "string",
          "default": "rgba(30, 140, 200, 0.6)",
          "description": "Color for modified lines gutter indicator"
        },
        "diffMark.deletedColor": {
          "type": "string",
          "default": "rgba(200, 50, 50, 0.6)",
          "description": "Color for deleted lines gutter indicator"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0"
  }
}
